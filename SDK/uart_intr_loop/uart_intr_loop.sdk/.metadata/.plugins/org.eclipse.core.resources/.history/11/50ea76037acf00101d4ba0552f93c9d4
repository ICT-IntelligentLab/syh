#include "xparameters.h"
#include "xuartps.h"
#include "xscugic.h"

#define UART_DEVICE_ID		XPAR_XUARTPS_0_DEVICE_ID
#define INTC_DEVICE_ID		XPAR_SCUGIC_SINGLE_DEVICE_ID
XUartPs_Config *Config;
XUartPs UartPs;
int uart_init(){

	int Status;

	Config = XUartPs_LookupConfig(UART_DEVICE_ID);
	XUartPs_CfgInitialize(&UartPs, Config, Config->BaseAddress);

	//硬件自检
	Status = XUartPs_SelfTest(&UartPs);
		if (Status != XST_SUCCESS) {
			return XST_FAILURE;
		}
	//设置中断模式
	XUartPs_SetOperMode(&UartPs, XUARTPS_OPER_MODE_NORMAL);
	//设置接收FIFO的触发阈值
	XUartPs_SetFifoThreshold(&UartPs, 1);
	//设置波特率
	XUartPs_SetBaudRate(&UartPs, 115200);

};
int uart_intr_init(){
	XScuGic_Config *IntcConfig;
	//初始化中断控制器函数
	XScuGic_LookupConfig(INTC_DEVICE_ID);
	XScuGic_CfgInitialize(&UartPs, IntcConfig,IntcConfig->CpuBaseAddress);




}
int main(void){

	//串口初始化
	uart_init();

	//串口中断初始化
	uart_intr_init();



	while(1);
	return 0;







}

